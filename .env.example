# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payment_system

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_heres
OPENAI_API_KEY=""

# Pino
LOG_LEVEL=info

# OpenTelemetry (fraud-engine / Python only)
# Service name spans are grouped under in the Jaeger UI.
OTEL_SERVICE_NAME=fraud-engine
# OTLP gRPC collector. `npm run docker:dev` starts Jaeger on this port; an
# http:// scheme selects an insecure channel. Unreachable collector = dropped
# spans, never a failed request.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Set true to skip provider registration entirely (CI, or local runs with no
# collector). Spans still get created and are dropped by the no-op provider.
OTEL_SDK_DISABLED=false
